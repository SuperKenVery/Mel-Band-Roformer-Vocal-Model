#!/usr/bin/env bash
set -e
if [[ ! -d "/Users/bytedance/Projects/melband-roformer-worktrees/simple-ralph-loop" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/Users/bytedance/Projects/melband-roformer-worktrees/simple-ralph-loop")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/Users/bytedance/Projects/melband-roformer-worktrees/simple-ralph-loop" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/Users/bytedance/Projects/melband-roformer-worktrees/simple-ralph-loop/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/Users/bytedance/Projects/melband-roformer-worktrees/simple-ralph-loop/.envrc" "/Users/bytedance/Projects/melband-roformer-worktrees/simple-ralph-loop/.direnv"/*.rc
